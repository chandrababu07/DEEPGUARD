# DeepGuard API & Deployment Configuration
# Copy this file to .env and customize for your deployment environment.

# Server Bind Settings
DEEPGUARD_HOST=127.0.0.1
DEEPGUARD_PORT=8000
DEEPGUARD_DEBUG=false

# Model Checkpoint & Serving
DEEPGUARD_CHECKPOINT_PATH=experiments/mini_baseline/checkpoints/deepguard_mobilenetv2_lstm_baseline.keras
DEEPGUARD_DECISION_THRESHOLD=0.5

# Upload Security Constraints
DEEPGUARD_MAX_UPLOAD_SIZE=104857600       # 100 MB in bytes
DEEPGUARD_MAX_VIDEO_DURATION=180.0        # 3 minutes in seconds

# Storage Directories
DEEPGUARD_UPLOAD_TMP_DIR=experiments/temp_uploads
DEEPGUARD_ARTIFACT_DIR=experiments/api_artifacts

# CORS Allowed Origins (comma-separated)
DEEPGUARD_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:3000
